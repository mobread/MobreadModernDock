<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Mobread Modern Dock"
           Manufacturer="mobread"
           Version="$(var.ProductVersion)"
           UpgradeCode="D913D973-3953-4E41-B58E-728E5E9974C3"
           Language="1033"
           Scope="perMachine">

    <!-- Same UpgradeCode across releases lets a new MSI replace the previous
         one and remove its files (the Windows Installer uninstalls the old
         product after the new files land). config.json lives in %APPDATA%,
         outside the install directory, so it is never touched. -->
    <MajorUpgrade Schedule="afterInstallExecuteAgain"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="IconApp" SourceFile="..\src\MobreadModernDock\Assets\icons\mobread\logo_256_ICO.ico" />
    <Property Id="ARPPRODUCTICON" Value="IconApp" />

    <!-- GPL-3.0 shown on the license agreement page. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Launch the dock when the install finishes (checkbox on the finish
         dialog, checked by default). WixShellExec launches unelevated in the
         installing user's session. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <WixVariable Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Mobread Modern Dock" />
    <InstallUISequence>
      <Custom Action="LaunchApp" OnExit="success"
              Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX AND NOT Installed" />
    </InstallUISequence>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="MobreadModernDock" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="Mobread Modern Dock" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="CMP_MainExe" Guid="*">
        <File Id="FILE_Exe" Source="publish\MobreadModernDock.exe" KeyPath="yes">
          <Shortcut Id="S_Desktop" Directory="DesktopFolder" Name="Mobread Modern Dock" />
          <Shortcut Id="S_StartMenu" Directory="AppMenuDir" Name="Mobread Modern Dock" />
        </File>
      </Component>
      <!-- Native Skia/HarfBuzz/ANGLE DLLs are bundled inside the single-file exe
           (IncludeNativeLibrariesForSelfExtract in build.ps1), so nothing else ships. -->
      <Component Id="CMP_AppMenuCleanup" Guid="*">
        <RemoveFolder Id="R_AppMenu" Directory="AppMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\MobreadModernDock" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Complete" Title="Mobread Modern Dock" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
  </Package>

  <Fragment>
    <!-- Launches the installed dock unelevated (WixUnelevatedShellExec in the
         Util extension's utilca.dll), reading the target from
         WixUnelevatedShellExecTarget, which resolves the [#FILE_Exe] formatted
         path when the action runs after the install completes. -->
    <CustomAction Id="LaunchApp" DllEntry="WixUnelevatedShellExec"
                  Execute="immediate" Return="ignore" Impersonate="yes"
                  BinaryRef="Wix4UtilCA_X64" />
    <Property Id="WixUnelevatedShellExecTarget" Value="[#FILE_Exe]" />
  </Fragment>
</Wix>
