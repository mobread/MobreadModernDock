<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:CedroModernDock.Views"
        x:Class="CedroModernDock.Views.FolderStackPopup"
        Title="Cedro Folder Stack"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        Topmost="True">

    <Border x:Name="Chrome" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="#40FFFFFF">
        <StackPanel Spacing="6" MaxWidth="560">
            <!-- Header: folder name + count, click to open in Explorer -->
            <Button x:Name="HeaderButton" Background="Transparent" BorderBrush="Transparent" Padding="4,2"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"
                    Click="OnOpenFolder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="HeaderText" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="CountText" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" MaxWidth="540"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:StackEntry">
                            <Button Width="84" Height="86" Margin="2" Padding="4"
                                    Background="Transparent" BorderBrush="Transparent" Cursor="Hand"
                                    ToolTip.Tip="{Binding Name}"
                                    Click="OnEntryClick"
                                    ContextRequested="OnEntryContext">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="#22FFFFFF"/>
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11"
                                               TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis" MaxWidth="76"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Foreground="#AAFFFFFF" FontSize="12" Margin="6,4" IsVisible="False"/>
        </StackPanel>
    </Border>
</Window>
