<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tray="using:CedroModernDock.Widgets.Tray"
             x:Class="CedroModernDock.Widgets.Tray.TrayWidgetView"
             x:DataType="tray:TrayWidgetViewModel">

    <Panel>
        <!-- Placeholder so an empty tray still shows a grabbable widget. -->
        <TextBlock Text="…" Foreground="#AAFFFFFF" IsVisible="{Binding IsEmpty}"
                   Margin="6,0" VerticalAlignment="Center"/>

        <ItemsControl ItemsSource="{Binding Icons}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="{Binding Orientation}" Spacing="{Binding Spacing}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="tray:TrayIconViewModel">
                    <Button Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="3"
                            Cursor="Hand"
                            ToolTip.Tip="{Binding Name}"
                            RenderTransformOrigin="50%, 50%"
                            Click="OnIconClick"
                            ContextRequested="OnIconContextRequested">

                        <Button.Transitions>
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                            </Transitions>
                        </Button.Transitions>
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="RenderTransform" Value="scale(1)"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="RenderTransform" Value="scale(1.25)"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </Button.Styles>

                        <Panel Width="{Binding Size}" Height="{Binding Size}">
                            <Image Source="{Binding Icon}"
                                   Stretch="Uniform"
                                   IsVisible="{Binding HasIcon}"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            <!-- No cached bitmap for this icon: show its initial. -->
                            <Border IsVisible="{Binding !HasIcon}"
                                    Background="#40FFFFFF" CornerRadius="4">
                                <TextBlock Text="{Binding FallbackGlyph}"
                                           Foreground="White" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11"/>
                            </Border>
                        </Panel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Panel>
</UserControl>
