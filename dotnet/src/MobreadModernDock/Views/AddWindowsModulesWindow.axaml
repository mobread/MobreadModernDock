<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MobreadModernDock.ViewModels"
        x:Class="MobreadModernDock.Views.AddWindowsModulesWindow"
        x:DataType="vm:AddWindowsModulesViewModel"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        MinWidth="360" MinHeight="240"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <StackPanel Orientation="Vertical" Spacing="16" Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#AAAAAA" TextWrapping="Wrap"/>
        <ListBox ItemsSource="{Binding ModuleNames}"
                 SelectedIndex="{Binding SelectedIndex}"
                 Background="#2D2D2D" Foreground="White"
                 BorderBrush="#444444" BorderThickness="1"
                 MinHeight="210" MaxHeight="210"
                 Margin="0,4,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WindowsModuleEntry">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                        <Image Source="{Binding Icon}" Width="18" Height="18"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="{Binding AddButtonText}"
                Click="OnAddSelected"
                HorizontalAlignment="Right"
                Background="#007ACC" Foreground="White"
                Padding="20,8" BorderBrush="Transparent"/>
    </StackPanel>
</Window>
