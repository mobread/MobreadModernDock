<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MobreadModernDock.ViewModels"
        xmlns:med="using:Avalonia.Media"
        xmlns:views="using:MobreadModernDock.Views"
        x:Class="MobreadModernDock.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/icons/mobread/logo_256.png"
        Width="960" Height="720"
        MinWidth="760" MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#141416"
        Closed="OnClosed">

    <Window.Resources>
        <!-- One accent. Slightly lighter than the dock's preset blue so it reads on #1A1A1D. -->
        <Color x:Key="AccentColor">#3B82F6</Color>
        <Color x:Key="AccentHover">#5B95F7</Color>
        <Color x:Key="AccentPressed">#2F6BD0</Color>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
        <!-- Fluent derives selection/focus colours from the OS accent (red on
             some machines). Pin them to ours so the window is one colour. -->
        <Color x:Key="SystemAccentColor">#3B82F6</Color>
        <Color x:Key="SystemAccentColorDark1">#2F6BD0</Color>
        <Color x:Key="SystemAccentColorDark2">#2559B0</Color>
        <Color x:Key="SystemAccentColorDark3">#1C4790</Color>
        <Color x:Key="SystemAccentColorLight1">#5B95F7</Color>
        <Color x:Key="SystemAccentColorLight2">#7BA9F8</Color>
        <Color x:Key="SystemAccentColorLight3">#9BBDF9</Color>
        <SolidColorBrush x:Key="AccentSoft" Color="#1F3B82F6"/>

        <GridLength x:Key="SliderPreContentMargin">4</GridLength>
        <GridLength x:Key="SliderPostContentMargin">4</GridLength>
        <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
        <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
        <CornerRadius x:Key="SliderThumbCornerRadius">8</CornerRadius>
        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="SliderTrackFill" Color="#2E2E33"/>
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#38383E"/>
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#38383E"/>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource AccentHover}"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource AccentPressed}"/>

        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{StaticResource AccentHover}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="{StaticResource AccentHover}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="{StaticResource AccentPressed}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="{StaticResource AccentPressed}"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#5A5A62"/>

        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#5A5A62"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource AccentHover}"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource AccentPressed}"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AccentHover}"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AccentPressed}"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentHover}"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AccentPressed}"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AccentHover}"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource AccentPressed}"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#2A2A2F"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#34343A"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#3C3C43"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#5A5A62"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#6E6E77"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#6E6E77"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#C8C8CE"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#DADAE0"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#DADAE0"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ComboBoxBackground" Color="#1F1F23"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#26262B"/>
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#26262B"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2E2E33"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#3F3F46"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextControlBackground" Color="#1F1F23"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#26262B"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1F1F23"/>
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2E2E33"/>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}"/>

        <!-- ListBoxItem selection in Fluent 11 comes from these system brushes. -->
        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#2E3B82F6"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#3E3B82F6"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#4E3B82F6"/>
        <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#1EFFFFFF"/>
        <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#3B82F6"/>
    </Window.Resources>

    <Window.Styles>
        <!-- ============ Navigation sidebar ============ -->
        <!-- The TabControl is kept (code-behind selects a tab by index) but
             re-templated into a left sidebar: headers stacked vertically in a
             dark rail, content on the right. -->
        <Style Selector="TabControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="200,*">
                        <Border Grid.Column="0" Background="#0F0F11" BorderBrush="#232327" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <!-- Brand block -->
                                <StackPanel DockPanel.Dock="Top" Margin="20,22,16,18" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Image Source="/Assets/icons/mobread/logo_256.png" Width="26" Height="26"/>
                                        <TextBlock Text="Mobread" FontSize="15" FontWeight="SemiBold" Foreground="#F2F2F5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="11" Foreground="#6E6E77" Margin="36,0,0,0"/>
                                </StackPanel>
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="10,0"/>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Column="1" Name="PART_Scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      AllowAutoHide="True">
                            <!-- Width pinned to the viewport: without it the content
                                 is measured unbounded and wide cards run off-screen.
                                 The page inset is a Margin here rather than the
                                 ScrollViewer's Padding: padding is not part of the
                                 scroll extent, so the bottom inset vanished once a
                                 page was scrolled to the end. -->
                            <ContentPresenter Name="PART_SelectedContentHost"
                                              Margin="32,24,28,40"
                                              Width="{Binding $parent[ScrollViewer].Viewport.Width, Converter={x:Static views:SettingsWindow.ContentWidth}}"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="2"/>
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#A0A0A8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_LayoutRoot" CornerRadius="8" Padding="12,9" Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Name="PART_Pipe" Width="3" Height="16" CornerRadius="2" Background="Transparent" VerticalAlignment="Center" Margin="-4,0,0,0"/>
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#16FFFFFF"/>
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="#E4E4E9"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_Pipe">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
        </Style>

        <!-- ============ Page vocabulary ============ -->
        <!-- page: header + sections. section: eyebrow caption + card. -->
        <Style Selector="StackPanel.page">
            <Setter Property="Spacing" Value="22"/>
            <Setter Property="MaxWidth" Value="820"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="StackPanel.pageHeader > TextBlock.pageSubtitle">
            <Setter Property="MaxWidth" Value="640"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="StackPanel.pageHeader">
            <Setter Property="Spacing" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F5F5F8"/>
        </Style>
        <Style Selector="TextBlock.pageSubtitle">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#8A8A93"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="Spacing" Value="8"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8A93"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#7C7C85"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E4E4E9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C8C8CE"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
        </Style>
        <Style Selector="TextBlock.warning">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#F0A64A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Card: a soft surface holding rows separated by hairlines. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1A1A1D"/>
            <Setter Property="BorderBrush" Value="#26262B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,6"/>
        </Style>
        <Style Selector="Border.card > StackPanel">
            <Setter Property="Spacing" Value="0"/>
        </Style>
        <!-- Row: [label + optional description] ... [control]. Rows inside a card
             separate with a hairline drawn by Border.row's bottom edge. -->
        <Style Selector="Grid.row">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="Grid.row > StackPanel.text">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Spacing" Value="2"/>
            <Setter Property="Margin" Value="0,10,16,10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Grid.row > StackPanel.text > TextBlock.helper">
            <Setter Property="MaxWidth" Value="460"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Grid.row > ToggleSwitch, Grid.row > ComboBox, Grid.row > StackPanel.control, Grid.row > Button, Grid.row > ColorPicker, Grid.row > TextBox">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="Border.hairline">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#26262B"/>
        </Style>
        <!-- Slider row: label above, slider + readout below. Wider tracks read
             better than the old inline 120px-label layout. -->
        <Style Selector="StackPanel.sliderRow">
            <Setter Property="Spacing" Value="0"/>
            <Setter Property="Margin" Value="0,10,0,8"/>
        </Style>
        <Style Selector="StackPanel.sliderRow > TextBlock.helper">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="StackPanel.sliderRow > Grid > Slider">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="StackPanel.sliderRow > Grid > TextBlock.value">
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
        <!-- Nested rows (indented under a toggle). -->
        <Style Selector="StackPanel.nested">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Spacing" Value="6"/>
        </Style>

        <!-- ============ Controls ============ -->
        <Style Selector="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OnContent" Value="{x:Null}"/>
            <Setter Property="OffContent" Value="{x:Null}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,-6,0"/>
        </Style>
        <Style Selector="ToggleSwitch /template/ Grid#PART_MovingKnobs">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E4E4E9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E4E4E9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F2F2F5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,0,8,0"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Foreground" Value="#F2F2F5"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="#1A1A1D"/>
            <Setter Property="BorderBrush" Value="#26262B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Foreground" Value="#E4E4E9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F2F2F5"/>
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="BorderBrush" Value="#33333A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#303036"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1F1F23"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5B95F7"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2F6BD0"/>
        </Style>
        <!-- Destructive: quiet until hovered, then red. Never a big red slab. -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4A2A2E"/>
            <Setter Property="Foreground" Value="#F08A8A"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3A1D21"/>
            <Setter Property="BorderBrush" Value="#7A3A40"/>
            <Setter Property="Foreground" Value="#FFB0B0"/>
        </Style>
        <Style Selector="Button.kofi">
            <Setter Property="Background" Value="#FF5E5B"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.kofi:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF7472"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <Style Selector="ColorPicker">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="True"/>
        </Style>
    </Window.Styles>

    <TabControl x:Name="Tabs" Tag="{Binding WindowTitle}">

        <!-- ===================== Items ===================== -->
        <TabItem Header="{Binding TabIcons}">
            <StackPanel Classes="page">
                <StackPanel Classes="pageHeader">
                    <TextBlock Classes="pageTitle" Text="{Binding TabIcons}"/>
                    <TextBlock Classes="pageSubtitle" Text="{Binding ItemsHelper}"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,20,220">
                    <StackPanel Grid.Column="0" Classes="section">
                        <TextBlock Classes="title" Text="{Binding ItemsTitle}"/>
                        <Grid>
                            <ListBox x:Name="ItemsList" ItemsSource="{Binding ItemEntries}" SelectedIndex="{Binding SelectedItemIndex}"
                                     MinHeight="300" MaxHeight="420"
                                     Cursor="SizeAll"
                                     DragDrop.AllowDrop="True"
                                     DragDrop.DragOver="OnItemsDragOver"
                                     DragDrop.DragLeave="OnItemsDragLeave"
                                     DragDrop.Drop="OnItemsDrop"
                                     PointerMoved="OnItemsPointerMoved"
                                     PointerReleased="OnItemsPointerReleased"
                                     PointerCaptureLost="OnItemsPointerCaptureLost">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DockItemListEntry">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Image Source="/Assets/icons/draggable.png" Width="10" Height="10"
                                                   Stretch="Uniform" VerticalAlignment="Center" Opacity="0.4"/>
                                            <Border Width="26" Height="26" CornerRadius="6" Background="#0FFFFFFF">
                                                <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="DropIndicator" IsVisible="False" Height="2"
                                    Background="{StaticResource Accent}" CornerRadius="1"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="8,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding MoveUpText}" Click="OnMoveUp" IsEnabled="{Binding CanMoveUp}"/>
                            <Button Content="{Binding MoveDownText}" Click="OnMoveDown" IsEnabled="{Binding CanMoveDown}"/>
                            <Button Classes="danger" Content="{Binding RemoveText}" Click="OnRemove" IsEnabled="{Binding CanRemove}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Classes="section">
                        <TextBlock Classes="title" Text="{Binding ActionsTitle}"/>
                        <Border Classes="card" Padding="10">
                            <StackPanel Spacing="6">
                                <Button Classes="primary" Content="{Binding AddProgramText}" Click="OnAddProgram" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                                <Button Content="{Binding AddFolderText}" Click="OnAddFolder" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                                <Button Content="{Binding AddModuleText}" Click="OnAddModule" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                                <Button Content="{Binding AddSeparatorText}" Click="OnAddSeparator" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                                <Border Classes="hairline" Margin="0,4"/>
                                <Button Content="{Binding ImportTaskbarText}" Click="OnImportTaskbar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="helper" Text="{Binding ActionsHelper}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </TabItem>

        <!-- ===================== Appearance ===================== -->
        <TabItem Header="{Binding TabAppearance}">
            <StackPanel Classes="page">
                <StackPanel Classes="pageHeader">
                    <TextBlock Classes="pageTitle" Text="{Binding TabAppearance}"/>
                    <TextBlock Classes="pageSubtitle" Text="{Binding PresetsHelper}"/>
                </StackPanel>

                <!-- Presets & themes -->
                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding PresetsTitle}"/>
                    <Border Classes="card" Padding="18,14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                                <ComboBox x:Name="PresetCombo" HorizontalAlignment="Stretch" ItemsSource="{Binding PresetNames}" SelectedIndex="{Binding SelectedPresetIndex}"/>
                                <Button Grid.Column="2" Classes="primary" Content="{Binding PresetApplyText}" Click="OnApplyPreset" IsEnabled="{Binding CanApplyPreset}"/>
                                <Button Grid.Column="4" Classes="danger" Content="{Binding PresetDeleteText}" Click="OnDeletePreset" IsEnabled="{Binding CanDeletePreset}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,8,Auto">
                                <TextBox Watermark="{Binding PresetNameHint}" Text="{Binding NewPresetName}"/>
                                <Button Grid.Column="2" Content="{Binding PresetSaveText}" Click="OnSavePreset" IsEnabled="{Binding CanSavePreset}"/>
                            </Grid>
                            <Border Classes="hairline" Margin="0,4"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="helper" Text="{Binding ThemeHelper}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="helper" VerticalAlignment="Center" Text="{Binding ThemeStatusText}"/>
                                    <Button Content="{Binding ThemeImportText}" Click="OnImportTheme"/>
                                    <Button Content="{Binding ThemeExportText}" Click="OnExportTheme"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Dock surface -->
                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding SectionDock}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding BgColorTitle}"/>
                                    <TextBlock Classes="helper" Text="{Binding BgColorHelper}"/>
                                </StackPanel>
                                <StackPanel Classes="control" Orientation="Horizontal" Spacing="10">
                                    <Border Classes="swatch" Background="{Binding DockColorBrush}"/>
                                    <ColorPicker Color="{Binding DockColor, Mode=TwoWay}"
                                                 ColorSpectrumShape="Ring" IsAlphaVisible="False" IsAlphaEnabled="False"
                                                 IsColorPaletteVisible="True" PaletteColors="{Binding PresetPaletteColors}" PaletteColumnCount="6"/>
                                </StackPanel>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding FollowSystemThemeText}"/>
                                    <TextBlock Classes="helper" Text="{Binding FollowSystemThemeHelper}"/>
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding FollowSystemTheme}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <StackPanel Classes="sliderRow">
                                <TextBlock Classes="label" Text="{Binding TransparencyTitle}" ToolTip.Tip="{Binding TransparencyHelper}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="0" Maximum="100" Value="{Binding Transparency}"/>
                                    <TextBlock Classes="value" Text="{Binding Transparency, StringFormat='{}{0}%'}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Classes="sliderRow">
                                <TextBlock Classes="label" Text="{Binding GlobalOpacityTitle}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="20" Maximum="100" Value="{Binding GlobalOpacity}"/>
                                    <TextBlock Classes="value" Text="{Binding GlobalOpacity, StringFormat='{}{0}%'}"/>
                                </Grid>
                                <TextBlock Classes="helper" Text="{Binding GlobalOpacityHelper}"/>
                            </StackPanel>
                            <StackPanel Classes="sliderRow">
                                <TextBlock Classes="label" Text="{Binding RoundingTitle}" ToolTip.Tip="{Binding RoundingHelper}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="0" Maximum="30" Value="{Binding BorderRounding}"/>
                                    <TextBlock Classes="value" Text="{Binding BorderRounding, StringFormat='{}{0} px'}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Classes="sliderRow">
                                <TextBlock Classes="label" Text="{Binding DockPaddingTitle}" ToolTip.Tip="{Binding DockPaddingHelper}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="0" Maximum="40" Value="{Binding DockPadding}"/>
                                    <TextBlock Classes="value" Text="{Binding DockPadding, StringFormat='{}{0} px'}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Icons -->
                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding SectionIcons}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <StackPanel Classes="sliderRow">
                                <TextBlock Classes="label" Text="{Binding IconSizeTitle}" ToolTip.Tip="{Binding IconSizeHelper}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="16" Maximum="80" Value="{Binding IconSize}"/>
                                    <TextBlock Classes="value" Text="{Binding IconSize, StringFormat='{}{0} px'}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Classes="sliderRow">
                                <TextBlock Classes="label" Text="{Binding SpacingTitle}" ToolTip.Tip="{Binding SpacingHelper}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="0" Maximum="20" Value="{Binding IconSpacing}"/>
                                    <TextBlock Classes="value" Text="{Binding IconSpacing, StringFormat='{}{0} px'}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Classes="sliderRow">
                                <TextBlock Classes="label" Text="{Binding DockRowsTitle}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DockRows}"/>
                                    <TextBlock Classes="value" Text="{Binding DockRows}"/>
                                </Grid>
                                <TextBlock Classes="helper" Text="{Binding DockRowsHelper}"/>
                            </StackPanel>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding MagnifyIconsText}"/>
                                    <TextBlock Classes="helper" Text="{Binding MagnifyIconsHelper}"/>
                                    <TextBlock Classes="warning" Text="{Binding MagnifyRowsWarning}" IsVisible="{Binding ShowMagnifyRowsWarning}"/>
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding MagnifyIcons}"/>
                            </Grid>
                            <StackPanel Classes="sliderRow" IsVisible="{Binding MagnifyIcons}" Margin="0,0,0,12">
                                <TextBlock Classes="label" Text="{Binding MagnifyScaleTitle}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="110" Maximum="250" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding MagnifyScale}"/>
                                    <TextBlock Classes="value" Text="{Binding MagnifyScaleLabel}"/>
                                </Grid>
                            </StackPanel>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding TintIconsTitle}"/>
                                    <TextBlock Classes="helper" Text="{Binding TintColorHelper}"/>
                                </StackPanel>
                                <StackPanel Classes="control" Orientation="Horizontal" Spacing="10">
                                    <Border Classes="swatch" Background="{Binding TintColorBrush}" IsVisible="{Binding TintIcons}"/>
                                    <ColorPicker Color="{Binding TintColor, Mode=TwoWay}" IsVisible="{Binding TintIcons}"
                                                 ColorSpectrumShape="Ring" IsAlphaVisible="False" IsAlphaEnabled="False"
                                                 IsColorPaletteVisible="True" PaletteColors="{Binding PresetPaletteColors}" PaletteColumnCount="6"/>
                                    <ToggleSwitch IsChecked="{Binding TintIcons}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </TabItem>

        <!-- ===================== Layout ===================== -->
        <TabItem Header="{Binding TabLayout}">
            <StackPanel Classes="page">
                <StackPanel Classes="pageHeader">
                    <TextBlock Classes="pageTitle" Text="{Binding TabLayout}"/>
                    <TextBlock Classes="pageSubtitle" Text="{Binding PosModeHelper}"/>
                </StackPanel>

                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding PosModeTitle}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding ArrangeVerticalText}"/>
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding IsVerticalDock}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding PosModeTitle}"/>
                                    <TextBlock Classes="helper" Text="{Binding DynamicPosHelper}" IsVisible="{Binding !IsStaticMode}"/>
                                </StackPanel>
                                <StackPanel Classes="control" Orientation="Horizontal" Spacing="16">
                                    <RadioButton Content="{Binding StaticText}" IsChecked="{Binding IsStaticMode}"/>
                                    <RadioButton Content="{Binding DynamicText}" IsChecked="{Binding !IsStaticMode}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Classes="section" IsVisible="{Binding IsStaticMode}">
                    <TextBlock Classes="title" Text="{Binding AlignmentTitle}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding VerticalText}"/>
                                </StackPanel>
                                <ComboBox MinWidth="150" ItemsSource="{Binding VerticalAnchorOptions}" SelectedItem="{Binding SelectedVerticalOption}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AnchorOption">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding HorizontalText}"/>
                                </StackPanel>
                                <ComboBox MinWidth="150" ItemsSource="{Binding HorizontalAnchorOptions}" SelectedItem="{Binding SelectedHorizontalOption}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HorizontalAnchorOption">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Border Classes="hairline"/>
                            <TextBlock Classes="title" Text="{Binding ScreenSpacingTitle}" Margin="0,14,0,0"/>
                            <Grid ColumnDefinitions="*,24,*" Margin="0,0,0,6">
                                <StackPanel Grid.Column="0">
                                    <StackPanel Classes="sliderRow">
                                        <TextBlock Classes="label" Text="{Binding TopSpacingLabel}"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Slider Minimum="0" Maximum="100" Value="{Binding TopSpacing}"/>
                                            <TextBlock Classes="value" Text="{Binding TopSpacing}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Classes="sliderRow">
                                        <TextBlock Classes="label" Text="{Binding LeftSpacingLabel}"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Slider Minimum="0" Maximum="100" Value="{Binding LeftSpacing}"/>
                                            <TextBlock Classes="value" Text="{Binding LeftSpacing}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Classes="sliderRow">
                                        <TextBlock Classes="label" Text="{Binding BottomSpacingLabel}"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Slider Minimum="0" Maximum="100" Value="{Binding BottomSpacing}"/>
                                            <TextBlock Classes="value" Text="{Binding BottomSpacing}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Classes="sliderRow">
                                        <TextBlock Classes="label" Text="{Binding RightSpacingLabel}"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Slider Minimum="0" Maximum="100" Value="{Binding RightSpacing}"/>
                                            <TextBlock Classes="value" Text="{Binding RightSpacing}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding SectionMonitors}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding MirrorMonitorsText}"/>
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding MirrorMonitors}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding EdgeSnappingText}"/>
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding EdgeSnapping}"/>
                            </Grid>
                            <StackPanel Classes="sliderRow" IsVisible="{Binding EdgeSnapping}" Margin="0,0,0,12">
                                <TextBlock Classes="helper" Text="{Binding EdgeSnapMarginTitle}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="0" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding EdgeSnapMargin}"/>
                                    <TextBlock Classes="value" Text="{Binding EdgeSnapMarginLabel}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </TabItem>

        <!-- ===================== Behavior ===================== -->
        <TabItem Header="{Binding TabBehavior}">
            <StackPanel Classes="page">
                <StackPanel Classes="pageHeader">
                    <TextBlock Classes="pageTitle" Text="{Binding TabBehavior}"/>
                </StackPanel>

                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding SectionVisibility}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding AlwaysOnTopText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding AlwaysOnTop}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding AutoHideText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding AutoHide}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding HideInFullscreenText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding HideInFullscreen}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding HideTaskbarText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding HideTaskbar}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding ReserveScreenEdgeText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding ReserveScreenEdge}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding LockDockText}"/>
                                    <TextBlock Classes="helper" Text="{Binding LockDockHelper}"/>
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding LockDock}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding SectionApps}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding ShowUnpinnedRunningAppsText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding ShowUnpinnedRunningApps}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding AttentionBounceText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding AttentionBounce}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding LaunchBounceText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding LaunchBounce}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding FolderStacksText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding FolderStacks}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <StackPanel Classes="sliderRow">
                                <TextBlock Classes="label" Text="{Binding PreviewDelayTitle}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="0" Maximum="2000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding PreviewDelay}"/>
                                    <TextBlock Classes="value" MinWidth="64" Text="{Binding PreviewDelayLabel}"/>
                                </Grid>
                                <TextBlock Classes="helper" Text="{Binding PreviewDelayHelper}"/>
                            </StackPanel>
                            <Border Classes="hairline"/>
                            <StackPanel Classes="sliderRow">
                                <TextBlock Classes="label" Text="{Binding PreviewSizeTitle}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider Minimum="50" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding PreviewSize}"/>
                                    <TextBlock Classes="value" MinWidth="64" Text="{Binding PreviewSizeLabel}"/>
                                </Grid>
                                <TextBlock Classes="helper" Text="{Binding PreviewSizeHelper}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding SectionHideForApps}"/>
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="helper" Text="{Binding HideForAppsHelper}" TextWrapping="Wrap"/>
                            <ListBox x:Name="HideForAppsList" ItemsSource="{Binding HideForAppsEntries}"
                                     SelectedIndex="{Binding SelectedHideForAppIndex}"
                                     MinHeight="80" MaxHeight="200"/>
                            <TextBlock Classes="helper" Text="{Binding HideForAppsEmptyText}" IsVisible="{Binding HideForAppsIsEmpty}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding HideForAppsAddText}" Click="OnAddHideForApp"/>
                                <Button Content="{Binding HideForAppsAddRunningText}" Click="OnAddRunningHideForApp"/>
                                <Button Content="{Binding HideForAppsRemoveText}" Click="OnRemoveHideForApp" IsEnabled="{Binding CanRemoveHideForApp}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding SectionHotkeys}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding HotkeysEnabledText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding HotkeysEnabled}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding HotkeysEnabled}">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding HotkeyToggleText}"/>
                                    <TextBlock Classes="helper" Text="{Binding HotkeyToggleHelper}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="160" Text="{Binding HotkeyToggleDock, UpdateSourceTrigger=LostFocus}" Watermark="Ctrl+Alt+D"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto" IsEnabled="{Binding HotkeysEnabled}">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="label" Text="{Binding HotkeyLaunchText}"/>
                                    <TextBlock Classes="helper" Text="{Binding HotkeyLaunchHelper}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Width="160" Text="{Binding HotkeyLaunchModifiers, UpdateSourceTrigger=LostFocus}" Watermark="Ctrl+Alt"/>
                            </Grid>
                            <TextBlock Classes="helper" Foreground="#F59E0B" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="{Binding HotkeyStatus}" IsVisible="{Binding HasHotkeyStatus}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </TabItem>

        <!-- ===================== Widgets ===================== -->
        <TabItem Header="{Binding TabWidget}">
            <!-- A Grid, not a StackPanel: the detail card must be measured with
                 the real remaining width so the embedded widget panel wraps. -->
            <Grid RowDefinitions="Auto,22,*">
                <StackPanel Classes="pageHeader">
                    <TextBlock Classes="pageTitle" Text="{Binding WidgetsTitle}"/>
                    <TextBlock Classes="pageSubtitle" Text="{Binding WidgetsHelper}"/>
                </StackPanel>

                <Grid Grid.Row="2" ColumnDefinitions="230,20,*">
                    <StackPanel Grid.Column="0" Classes="section">
                        <ListBox x:Name="WidgetsList" MinHeight="260" MaxHeight="420" SelectionChanged="OnWidgetSelectionChanged"/>
                        <Grid ColumnDefinitions="*,6,Auto">
                            <ComboBox x:Name="WidgetTypeCombo" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="2" Classes="primary" Content="{Binding WidgetAddText}" Click="OnAddWidget"/>
                        </Grid>
                        <Button x:Name="RemoveWidgetButton" Classes="danger" Content="{Binding WidgetRemoveText}" Click="OnRemoveWidget"
                                HorizontalAlignment="Left" IsEnabled="False"/>
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <!-- Empty state: shown until a widget is selected. -->
                        <Border x:Name="WidgetNoSelection" Classes="card" Padding="24" VerticalAlignment="Top"
                                Background="Transparent" BorderBrush="#2A2A30">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="⧉" FontSize="26" Foreground="#3F3F46" HorizontalAlignment="Center"/>
                                <TextBlock Classes="helper" Text="{Binding WidgetNoSelectionText}" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="WidgetDetailCard" Classes="card" Padding="18,6,18,14" VerticalAlignment="Top" IsVisible="False">
                            <StackPanel>
                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="text">
                                        <TextBlock Classes="label" Text="{Binding WidgetEnabledText}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="WidgetEnabledCheck" IsCheckedChanged="OnWidgetEnabledChanged" IsEnabled="False"/>
                                </Grid>
                                <Border Classes="hairline" Margin="0,0,0,10"/>
                                <ContentControl x:Name="WidgetSettingsHost"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===================== General ===================== -->
        <TabItem Header="{Binding TabGeneral}">
            <StackPanel Classes="page">
                <StackPanel Classes="pageHeader">
                    <TextBlock Classes="pageTitle" Text="{Binding TabGeneral}"/>
                </StackPanel>

                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding SectionStartup}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding LanguageLabel}"/></StackPanel>
                                <ComboBox MinWidth="200" ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding SelectedLanguageIndex}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding StartWithWindowsText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding IsAutoStartEnabled}"/>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text"><TextBlock Classes="label" Text="{Binding CheckUpdatesOnStartupText}"/></StackPanel>
                                <ToggleSwitch IsChecked="{Binding CheckUpdatesOnStartup}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding ConfigTitle}"/>
                    <Border Classes="card">
                        <Grid Classes="row" ColumnDefinitions="*,Auto">
                            <StackPanel Classes="text">
                                <TextBlock Classes="helper" Text="{Binding ConfigHelper}"/>
                                <TextBlock Classes="helper" Foreground="#9AB8F5" Text="{Binding ConfigStatusText}"/>
                            </StackPanel>
                            <StackPanel Classes="control" Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding ConfigImportText}" Click="OnImportConfig"/>
                                <Button Classes="primary" Content="{Binding ConfigExportText}" Click="OnExportConfig"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Classes="section">
                    <TextBlock Classes="title" Text="{Binding SectionAbout}"/>
                    <Border Classes="card">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Image Source="/Assets/icons/mobread/logo_256.png" Width="32" Height="32"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="label" Text="Mobread Modern Dock" FontWeight="SemiBold"/>
                                            <TextBlock Classes="helper" Text="{Binding VersionText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Classes="helper" Text="{Binding UpdateStatusText}" Margin="0,6,0,0"/>
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsInstallingUpdate}" Margin="0,6,0,0">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" Height="4" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Grid.Column="1" Classes="value" Margin="8,0,0,0" Text="{Binding UpdateProgressText}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Classes="control" Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding CheckUpdatesText}" Click="OnCheckUpdates" IsEnabled="{Binding !IsCheckingUpdates}"/>
                                    <Button Classes="primary" Content="{Binding InstallUpdateText}" Click="OnInstallUpdate" IsVisible="{Binding CanInstallUpdate}"/>
                                    <Button Content="{Binding DownloadUpdateText}" Click="OnDownloadUpdate" IsVisible="{Binding UpdateAvailable}"/>
                                </StackPanel>
                            </Grid>
                            <Border Classes="hairline"/>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                <StackPanel Classes="text">
                                    <TextBlock Classes="helper" Text="{Binding OpenSourceText}"/>
                                    <TextBlock Classes="helper" Text="{Binding RepoText}"/>
                                    <TextBlock Classes="helper" Text="{Binding ContactText}"/>
                                </StackPanel>
                                <StackPanel Classes="control" Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding AcknowledgementsText}" Click="OnAcknowledgements"/>
                                    <Button Classes="kofi" Content="{Binding KofiText}" Click="OnKofi"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
