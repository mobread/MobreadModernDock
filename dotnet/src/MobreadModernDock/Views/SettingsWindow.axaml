<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MobreadModernDock.ViewModels"
        xmlns:med="using:Avalonia.Media"
        x:Class="MobreadModernDock.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/icons/mobread/logo_256.png"
        Width="860" Height="700"
        MinWidth="720" MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Closed="OnClosed">

    <Window.Resources>
        <!-- Accent blue for sliders and radio buttons (matches the 7th preset swatch). -->
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#00508C"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#00508C"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#00508C"/>
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#00508C"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#00508C"/>
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#00508C"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#00508C"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#00508C"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#1E6BA6"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#1E6BA6"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#003A63"/>
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#003A63"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#00508C"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#1E6BA6"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#003A63"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#00508C"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#1E6BA6"/>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#003A63"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Single-row, compact tab strip: the Fluent theme wraps headers in a
             WrapPanel by default, stacking them 2-per-line in this narrow window.
             A horizontal StackPanel keeps all sections side-by-side. -->
        <Style Selector="TabControl">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <!-- Clicking a tab gives it keyboard focus, which draws a 2px focus
                 ring (system accent color) around the selected tab. Disable it. -->
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#3A3A3A"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- The Fluent theme draws a 2px accent-colored pipe under the selected
             tab (PART_SelectedPipe). The blue selected background is already the
             highlight, so suppress the pipe. -->
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Layout vocabulary shared by every tab: a page is a vertical stack of
             sections; a section is a title, optional helper line and a card. -->
        <Style Selector="StackPanel.page">
            <Setter Property="Spacing" Value="18"/>
            <Setter Property="Margin" Value="4,12,4,4"/>
        </Style>
        <Style Selector="StackPanel.section">
            <Setter Property="Spacing" Value="6"/>
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
        <Style Selector="Border.card > StackPanel">
            <Setter Property="Spacing" Value="10"/>
        </Style>
        <!-- Labelled slider row: label | slider | value.
             (ColumnDefinitions is not a styled property; set inline on each row.) -->
        <Style Selector="Grid.sliderRow > Slider">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style Selector="Grid.sliderRow > TextBlock.value">
            <Setter Property="Grid.Column" Value="2"/>
        </Style>
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.swatch:pointerover">
            <Setter Property="BorderBrush" Value="White"/>
        </Style>

        <!-- Controls -->
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#444444"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#007ACC"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#D33333"/>
        </Style>
        <!-- Ko-fi brand red, as on the README badge. -->
        <Style Selector="Button.kofi">
            <Setter Property="Background" Value="#FF5E5B"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- The Fluent theme uses overlay (auto-hiding) scrollbars by default: the
             track is transparent and the thumb collapses to a sliver until hovered.
             Force them always visible so users can see the content is scrollable. -->
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Window.Styles>

    <ScrollViewer Padding="20,16,20,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  AllowAutoHide="False">
        <TabControl Background="Transparent" Padding="0,8,0,0" VerticalContentAlignment="Top">

            <!-- ===================== Items ===================== -->
            <TabItem Header="{Binding TabIcons}">
                <Grid ColumnDefinitions="2*,16,3*" Classes="page" Margin="4,12,4,4">
                    <StackPanel Grid.Column="0" Classes="section">
                        <TextBlock Classes="title" Text="{Binding ItemsTitle}"/>
                        <TextBlock Classes="helper" Text="{Binding ItemsHelper}"/>
                        <Grid>
                            <ListBox x:Name="ItemsList" ItemsSource="{Binding ItemEntries}" SelectedIndex="{Binding SelectedItemIndex}"
                                     Background="#252525" Foreground="White" BorderBrush="#333333" BorderThickness="1" CornerRadius="6"
                                     MinHeight="260" MaxHeight="340"
                                     Cursor="SizeAll"
                                     DragDrop.AllowDrop="True"
                                     DragDrop.DragOver="OnItemsDragOver"
                                     DragDrop.DragLeave="OnItemsDragLeave"
                                     DragDrop.Drop="OnItemsDrop"
                                     PointerMoved="OnItemsPointerMoved"
                                     PointerReleased="OnItemsPointerReleased"
                                     PointerCaptureLost="OnItemsPointerCaptureLost">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DockItemListEntry">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                            <Image Source="/Assets/icons/draggable.png" Width="12" Height="12"
                                                   Stretch="Uniform" VerticalAlignment="Center" Opacity="0.55"/>
                                            <Image Source="{Binding Icon}" Width="18" Height="18"
                                                   Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- Insertion indicator: a 2px accent bar shown while a
                                 drag hovers over the list, positioned at the gap. -->
                            <Border x:Name="DropIndicator" IsVisible="False" Height="2"
                                    Background="#007ACC" CornerRadius="1"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding MoveUpText}" Click="OnMoveUp" IsEnabled="{Binding CanMoveUp}"/>
                            <Button Content="{Binding MoveDownText}" Click="OnMoveDown" IsEnabled="{Binding CanMoveDown}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Classes="section">
                        <TextBlock Classes="title" Text="{Binding ActionsTitle}"/>
                        <TextBlock Classes="helper" Text="{Binding ActionsHelper}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <Button Classes="primary" Content="{Binding AddProgramText}" Click="OnAddProgram" HorizontalAlignment="Stretch"/>
                                <Button Classes="primary" Content="{Binding AddFolderText}" Click="OnAddFolder" HorizontalAlignment="Stretch"/>
                                <Button Classes="primary" Content="{Binding AddModuleText}" Click="OnAddModule" HorizontalAlignment="Stretch"/>
                                <Button Classes="primary" Content="{Binding ImportTaskbarText}" Click="OnImportTaskbar" HorizontalAlignment="Stretch"/>
                                <Button Content="{Binding AddSeparatorText}" Click="OnAddSeparator" HorizontalAlignment="Stretch"/>
                                <Button Classes="danger" Content="{Binding RemoveText}" Click="OnRemove" IsEnabled="{Binding CanRemove}"
                                        HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== Appearance ===================== -->
            <TabItem Header="{Binding TabAppearance}">
                <StackPanel Classes="page">
                    <!-- Presets -->
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="{Binding PresetsTitle}"/>
                        <TextBlock Classes="helper" Text="{Binding PresetsHelper}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="PresetCombo" Width="220" ItemsSource="{Binding PresetNames}" SelectedIndex="{Binding SelectedPresetIndex}"/>
                                    <Button Classes="primary" Content="{Binding PresetApplyText}" Click="OnApplyPreset" IsEnabled="{Binding CanApplyPreset}"/>
                                    <Button Classes="danger" Content="{Binding PresetDeleteText}" Click="OnDeletePreset" IsEnabled="{Binding CanDeletePreset}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="220" Watermark="{Binding PresetNameHint}" Text="{Binding NewPresetName}"/>
                                    <Button Content="{Binding PresetSaveText}" Click="OnSavePreset" IsEnabled="{Binding CanSavePreset}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Dock surface -->
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="{Binding SectionDock}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <Grid Classes="sliderRow" ColumnDefinitions="120,*,Auto">
                                    <TextBlock Classes="label" Text="{Binding TransparencyTitle}" ToolTip.Tip="{Binding TransparencyHelper}"/>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding Transparency}"/>
                                    <TextBlock Classes="value" Text="{Binding Transparency}"/>
                                </Grid>
                                <Grid Classes="sliderRow" ColumnDefinitions="120,*,Auto">
                                    <TextBlock Classes="label" Text="{Binding GlobalOpacityTitle}" ToolTip.Tip="{Binding GlobalOpacityHelper}"/>
                                    <Slider Minimum="20" Maximum="100" Value="{Binding GlobalOpacity}"/>
                                    <TextBlock Classes="value" Text="{Binding GlobalOpacity}"/>
                                </Grid>
                                <Grid Classes="sliderRow" ColumnDefinitions="120,*,Auto">
                                    <TextBlock Classes="label" Text="{Binding RoundingTitle}" ToolTip.Tip="{Binding RoundingHelper}"/>
                                    <Slider Minimum="0" Maximum="30" Value="{Binding BorderRounding}"/>
                                    <TextBlock Classes="value" Text="{Binding BorderRounding}"/>
                                </Grid>
                                <TextBlock Classes="helper" Text="{Binding GlobalOpacityHelper}"/>

                                <Border Height="1" Background="#333333" Margin="0,4"/>

                                <!-- Backdrop material. The radios bind to the
                                     three IsBlur* flags rather than a shared
                                     enum, so only the newly-checked one writes
                                     back (see SettingsViewModel.BlurMode). -->
                                <TextBlock Classes="label" Text="{Binding BlurTitle}"/>
                                <TextBlock Classes="helper" Text="{Binding BlurHelper}"/>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton GroupName="blurMode" Content="{Binding BlurNoneText}" IsChecked="{Binding IsBlurNone}"/>
                                    <RadioButton GroupName="blurMode" Content="{Binding BlurBlurText}" IsChecked="{Binding IsBlurBlur}"/>
                                    <RadioButton GroupName="blurMode" Content="{Binding BlurAcrylicText}" IsChecked="{Binding IsBlurAcrylic}"/>
                                </StackPanel>

                                <Border Height="1" Background="#333333" Margin="0,4"/>

                                <TextBlock Classes="label" Text="{Binding BgColorTitle}"/>
                                <TextBlock Classes="helper" Text="{Binding BgColorHelper}"/>
                                <!-- Sits with the colour picker because it
                                     overrides it: while on, the dock colour is
                                     driven by the Windows light/dark setting. -->
                                <CheckBox Content="{Binding FollowSystemThemeText}" IsChecked="{Binding FollowSystemTheme}"/>
                                <TextBlock Classes="helper" Text="{Binding FollowSystemThemeHelper}"/>
                                <ItemsControl ItemsSource="{Binding PresetColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="med:IBrush">
                                            <Border Classes="swatch" Background="{Binding}" PointerPressed="OnPresetColorPressed"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="48" Height="30" CornerRadius="6" BorderBrush="#666666" BorderThickness="1"
                                            Background="{Binding DockColorBrush}"/>
                                    <Button Classes="primary" Content="{Binding CustomColorText}" Click="OnCustomColor" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Icons -->
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="{Binding SectionIcons}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <Grid Classes="sliderRow" ColumnDefinitions="120,*,Auto">
                                    <TextBlock Classes="label" Text="{Binding IconSizeTitle}" ToolTip.Tip="{Binding IconSizeHelper}"/>
                                    <Slider Minimum="16" Maximum="80" Value="{Binding IconSize}"/>
                                    <TextBlock Classes="value" Text="{Binding IconSize}"/>
                                </Grid>
                                <Grid Classes="sliderRow" ColumnDefinitions="120,*,Auto">
                                    <TextBlock Classes="label" Text="{Binding SpacingTitle}" ToolTip.Tip="{Binding SpacingHelper}"/>
                                    <Slider Minimum="0" Maximum="20" Value="{Binding IconSpacing}"/>
                                    <TextBlock Classes="value" Text="{Binding IconSpacing}"/>
                                </Grid>
                                <Grid Classes="sliderRow" ColumnDefinitions="120,*,Auto">
                                    <TextBlock Classes="label" Text="{Binding DockRowsTitle}" ToolTip.Tip="{Binding DockRowsHelper}"/>
                                    <Slider Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DockRows}"/>
                                    <TextBlock Classes="value" Text="{Binding DockRows}"/>
                                </Grid>
                                <TextBlock Classes="helper" Text="{Binding DockRowsHelper}"/>

                                <Border Height="1" Background="#333333" Margin="0,4"/>

                                <CheckBox Content="{Binding TintIconsTitle}" IsChecked="{Binding TintIcons}"/>
                                <StackPanel Spacing="8" IsVisible="{Binding TintIcons}">
                                    <TextBlock Classes="helper" Text="{Binding TintColorHelper}"/>
                                    <ItemsControl ItemsSource="{Binding PresetColors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="med:IBrush">
                                                <Border Classes="swatch" Background="{Binding}" PointerPressed="OnTintPresetColorPressed"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="48" Height="30" CornerRadius="6" BorderBrush="#666666" BorderThickness="1"
                                                Background="{Binding TintColorBrush}"/>
                                        <Button Classes="primary" Content="{Binding CustomColorText}" Click="OnCustomTintColor" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ===================== Layout ===================== -->
            <TabItem Header="{Binding TabLayout}">
                <StackPanel Classes="page">
                    <!-- Positioning -->
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="{Binding PosModeTitle}"/>
                        <TextBlock Classes="helper" Text="{Binding PosModeHelper}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <CheckBox Content="{Binding ArrangeVerticalText}" IsChecked="{Binding IsVerticalDock}"/>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton Content="{Binding StaticText}" IsChecked="{Binding IsStaticMode}"/>
                                    <RadioButton Content="{Binding DynamicText}" IsChecked="{Binding !IsStaticMode}"/>
                                </StackPanel>
                                <TextBlock Classes="helper" Text="{Binding DynamicPosHelper}" IsVisible="{Binding !IsStaticMode}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Static-only: alignment + screen spacing -->
                    <StackPanel Classes="section" IsVisible="{Binding IsStaticMode}">
                        <TextBlock Classes="title" Text="{Binding AlignmentTitle}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <Grid ColumnDefinitions="120,Auto,24,Auto,8,Auto">
                                    <TextBlock Classes="label" Grid.Column="0" Text="{Binding VerticalText}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding VerticalAnchorOptions}" SelectedItem="{Binding SelectedVerticalOption}" MinWidth="110">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AnchorOption">
                                                <TextBlock Text="{Binding Label}" Foreground="White"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Classes="label" Grid.Column="3" Text="{Binding HorizontalText}"/>
                                    <ComboBox Grid.Column="5" ItemsSource="{Binding HorizontalAnchorOptions}" SelectedItem="{Binding SelectedHorizontalOption}" MinWidth="110">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HorizontalAnchorOption">
                                                <TextBlock Text="{Binding Label}" Foreground="White"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Border Height="1" Background="#333333" Margin="0,4"/>

                                <TextBlock Classes="label" Text="{Binding ScreenSpacingTitle}"/>
                                <Grid Classes="sliderRow" ColumnDefinitions="120,*,Auto">
                                    <TextBlock Classes="label" Text="{Binding TopSpacingLabel}"/>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding TopSpacing}"/>
                                    <TextBlock Classes="value" Text="{Binding TopSpacing}"/>
                                </Grid>
                                <Grid Classes="sliderRow" ColumnDefinitions="120,*,Auto">
                                    <TextBlock Classes="label" Text="{Binding BottomSpacingLabel}"/>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding BottomSpacing}"/>
                                    <TextBlock Classes="value" Text="{Binding BottomSpacing}"/>
                                </Grid>
                                <Grid Classes="sliderRow" ColumnDefinitions="120,*,Auto">
                                    <TextBlock Classes="label" Text="{Binding LeftSpacingLabel}"/>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding LeftSpacing}"/>
                                    <TextBlock Classes="value" Text="{Binding LeftSpacing}"/>
                                </Grid>
                                <Grid Classes="sliderRow" ColumnDefinitions="120,*,Auto">
                                    <TextBlock Classes="label" Text="{Binding RightSpacingLabel}"/>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding RightSpacing}"/>
                                    <TextBlock Classes="value" Text="{Binding RightSpacing}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Monitors & edges -->
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="{Binding SectionMonitors}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <CheckBox Content="{Binding MirrorMonitorsText}" IsChecked="{Binding MirrorMonitors}"/>
                                <CheckBox Content="{Binding EdgeSnappingText}" IsChecked="{Binding EdgeSnapping}"/>
                                <Grid Classes="sliderRow" ColumnDefinitions="Auto,*,Auto" Margin="24,0,0,0" IsVisible="{Binding EdgeSnapping}">
                                                                    <TextBlock Classes="helper" Text="{Binding EdgeSnapMarginTitle}" VerticalAlignment="Center"/>
                                                                    <Slider Minimum="0" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding EdgeSnapMargin}"/>
                                    <TextBlock Classes="value" Text="{Binding EdgeSnapMarginLabel}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ===================== Behavior ===================== -->
            <TabItem Header="{Binding TabBehavior}">
                <StackPanel Classes="page">
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="{Binding SectionVisibility}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <CheckBox Content="{Binding AlwaysOnTopText}" IsChecked="{Binding AlwaysOnTop}"/>
                                <CheckBox Content="{Binding AutoHideText}" IsChecked="{Binding AutoHide}"/>
                                <CheckBox Content="{Binding HideInFullscreenText}" IsChecked="{Binding HideInFullscreen}"/>
                                <CheckBox Content="{Binding HideTaskbarText}" IsChecked="{Binding HideTaskbar}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="{Binding SectionApps}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <CheckBox Content="{Binding ShowUnpinnedRunningAppsText}" IsChecked="{Binding ShowUnpinnedRunningApps}"/>
                                <CheckBox Content="{Binding AttentionBounceText}" IsChecked="{Binding AttentionBounce}"/>
                                <CheckBox Content="{Binding FolderStacksText}" IsChecked="{Binding FolderStacks}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ===================== Widgets ===================== -->
            <TabItem Header="{Binding TabWidget}">
                <Grid ColumnDefinitions="260,16,*" Margin="4,12,4,4">
                    <StackPanel Grid.Column="0" Classes="section">
                        <TextBlock Classes="title" Text="{Binding WidgetsTitle}"/>
                        <TextBlock Classes="helper" Text="{Binding WidgetsHelper}"/>
                        <ListBox x:Name="WidgetsList" MinHeight="200" MaxHeight="360" Background="#252525" BorderBrush="#333333" BorderThickness="1" CornerRadius="6"
                                 SelectionChanged="OnWidgetSelectionChanged"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="WidgetTypeCombo" MinWidth="140"/>
                            <Button Classes="primary" Content="{Binding WidgetAddText}" Click="OnAddWidget"/>
                        </StackPanel>
                        <Button x:Name="RemoveWidgetButton" Classes="danger" Content="{Binding WidgetRemoveText}" Click="OnRemoveWidget"
                                HorizontalAlignment="Left" IsEnabled="False"/>
                    </StackPanel>

                    <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
                        <StackPanel>
                            <CheckBox x:Name="WidgetEnabledCheck" Content="{Binding WidgetEnabledText}"
                                      IsCheckedChanged="OnWidgetEnabledChanged" IsEnabled="False"/>
                            <TextBlock x:Name="WidgetNoSelection" Classes="helper" Text="{Binding WidgetNoSelectionText}"/>
                            <ContentControl x:Name="WidgetSettingsHost"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== General ===================== -->
            <TabItem Header="{Binding TabGeneral}">
                <StackPanel Classes="page">
                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="{Binding SectionStartup}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="label" Text="{Binding LanguageLabel}" MinWidth="120"/>
                                    <ComboBox ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding SelectedLanguageIndex}" MinWidth="200"/>
                                </StackPanel>
                                <CheckBox Content="{Binding StartWithWindowsText}" IsChecked="{Binding IsAutoStartEnabled}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="{Binding ConfigTitle}"/>
                        <TextBlock Classes="helper" Text="{Binding ConfigHelper}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="{Binding ConfigExportText}" Click="OnExportConfig"/>
                                    <Button Content="{Binding ConfigImportText}" Click="OnImportConfig"/>
                                    <TextBlock Classes="label" Text="{Binding ConfigStatusText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Classes="section">
                        <TextBlock Classes="title" Text="{Binding SectionAbout}"/>
                        <Border Classes="card">
                            <StackPanel>
                                <TextBlock Classes="label" Text="{Binding VersionText}" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding CheckUpdatesText}" Click="OnCheckUpdates" IsEnabled="{Binding !IsCheckingUpdates}"/>
                                    <Button Classes="primary" Content="{Binding DownloadUpdateText}" Click="OnDownloadUpdate" IsVisible="{Binding UpdateAvailable}"/>
                                    <TextBlock Classes="label" Text="{Binding UpdateStatusText}"/>
                                </StackPanel>

                                <Border Height="1" Background="#333333" Margin="0,4"/>

                                <TextBlock Classes="label" Text="{Binding OpenSourceText}"/>
                                <TextBlock Classes="label" Text="{Binding RepoText}"/>
                                <TextBlock Classes="label" Text="{Binding ContactText}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding AcknowledgementsText}" Click="OnAcknowledgements"/>
                                    <Button Classes="kofi" Content="{Binding KofiText}" Click="OnKofi"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </ScrollViewer>
</Window>
