<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MobreadModernDock.ViewModels"
        x:Class="MobreadModernDock.Views.AcknowledgementsWindow"
        x:DataType="vm:AcknowledgementsViewModel"
        Title="{Binding Title}"
        Width="420" Height="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <ScrollViewer Padding="24">
        <StackPanel Orientation="Vertical" Spacing="16">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="{Binding Subtitle}"
                       FontSize="13" Foreground="#AAAAAA" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LibrariesTitle}" FontSize="14" FontWeight="SemiBold"
                       Foreground="#CCCCCC" Margin="0,8,0,0"/>
            <StackPanel Orientation="Vertical" Spacing="8" Margin="0,4,0,0">
                <TextBlock Text="• Avalonia UI 11.3 — cross-platform .NET UI framework" Foreground="#CCCCCC" FontSize="13"/>
                <TextBlock Text="• CommunityToolkit.Mvvm — MVVM source generators" Foreground="#CCCCCC" FontSize="13"/>
                <TextBlock Text="• System.Text.Json — JSON serialization" Foreground="#CCCCCC" FontSize="13"/>
                <TextBlock Text="• System.Drawing.Common — icon extraction" Foreground="#CCCCCC" FontSize="13"/>
                <TextBlock Text="• .NET 9 — application runtime" Foreground="#CCCCCC" FontSize="13"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
