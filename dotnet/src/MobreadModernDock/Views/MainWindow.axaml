<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MobreadModernDock.ViewModels"
        xmlns:views="using:MobreadModernDock.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="80"
        x:Class="MobreadModernDock.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Mobread Modern Dock"
        Icon="/Assets/icons/mobread/logo_256.png"
        Width="500" Height="80"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        PointerPressed="OnPointerPressed">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Hover zoom for dock items. Defined here rather than inside the item
             template so it can be suppressed while the dock is magnified:
             DockItemsPanel sets RenderTransform as a local value, and an
             unconditional style setter would beat it and cancel the effect. -->
        <Style Selector="ItemsControl:not(.magnified) Button.dockitem">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="ItemsControl:not(.magnified) Button.dockitem:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.3)" />
        </Style>
    </Window.Styles>

    <!-- Dock bar: rounded background with items. The top margin is transparent
         headroom so an attention-bounce (icon hops 10 px up) isn't clipped by
         the window edge; ClipToBounds is off for the same reason. -->
    <Border x:Name="DockBar"
            Opacity="{Binding WindowOpacity}"
            Background="{Binding EffectiveDockBackground}"
            CornerRadius="{Binding DockCornerRadius}"
            Padding="10"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ClipToBounds="False"
            DragDrop.AllowDrop="True"
            DragDrop.DragOver="OnDockDragOver"
            DragDrop.DragLeave="OnDockDragLeave"
            DragDrop.Drop="OnDockDrop">

        <StackPanel Orientation="{Binding DockOrientation}" Spacing="{Binding Spacing}">
            <!-- Pinned dock items. Drag an icon past a small threshold to
                 reorder it in place; a plain click still launches. The Panel
                 overlays a thin drop indicator at the target gap. -->
            <Panel>
            <ItemsControl x:Name="PinnedItems" ClipToBounds="False"
                          ItemsSource="{Binding Items}"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragOver="OnPinnedDragOver"
                          DragDrop.DragLeave="OnPinnedDragLeave"
                          DragDrop.Drop="OnPinnedDrop">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Variable-width layout: wraps the pinned icons into
                             N rows (horizontal dock) or N columns (vertical),
                             but unlike a UniformGrid it gives each item its own
                             width, so a separator takes only the space it
                             draws instead of a whole icon cell.
                             Lines/IsVertical are pushed in from code-behind:
                             an ItemsPanelTemplate has no DataContext, so a
                             plain {Binding} here silently binds nothing. -->
                        <views:DockItemsPanel x:Name="PinnedPanel" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DockItemViewModel">
                        <Button ClipToBounds="False" Command="{Binding ClickCommand}"
                                CommandParameter="{Binding}"
                                Classes="dockitem"
                                Classes.separator="{Binding IsSeparator}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4"
                                Margin="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CellMargin}"
                                Cursor="Hand"
                                ToolTip.Tip="{Binding Label}"
                                ToolTip.Placement="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TooltipPlacement}"
                                ToolTip.VerticalOffset="0"
                                ToolTip.HorizontalOffset="0"
                                ToolTip.ShowDelay="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).PreviewDelayMs}"
                                RenderTransformOrigin="50%, 50%"
                                PointerEntered="OnItemPointerEntered"
                                PointerExited="OnItemPointerExited"
                                PointerWheelChanged="OnItemPointerWheel"
                                ContextRequested="OnPinnedItemContextRequested">

                            <!-- Hover scale animation. Both scale states come from styles:
                                 a local RenderTransform would win over the :pointerover
                                 style setter and disable the effect. scale(n) parses to
                                 TransformOperations, which TransformOperationsTransition
                                 animates smoothly. -->
                            <Button.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                                </Transitions>
                            </Button.Transitions>

                            <Button.Styles>
                                <!-- Hover zoom lives at window level (see
                                     Window.Styles) so it can be disabled while
                                     the dock is magnified: an unconditional
                                     setter here would beat the panel's local
                                     RenderTransform and cancel the effect. -->
                                <!-- A separator is not a target: no hover zoom,
                                     no hand cursor, and no icon padding - the
                                     Button's 4px padding plus the shared cell
                                     margin would otherwise pad a 2px line out
                                     to ~13px. -->
                                <Style Selector="ItemsControl:not(.magnified) Button.separator:pointerover">
                                    <Setter Property="RenderTransform" Value="scale(1)" />
                                </Style>
                                <Style Selector="Button.separator">
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="3,0" />
                                </Style>
                                <!-- The Fluent theme paints a gray hover/pressed background
                                     on the button's template part; dock items must stay
                                     background-free (scoped styles override the theme). -->
                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <!-- Attention bounce translates the icon above the button; don't clip it. -->
                                <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="ClipToBounds" Value="False" />
                                </Style>
                            </Button.Styles>

                            <!-- Item content: icon + running indicator, or a
                                 plain divider for separator items. Both live
                                 in the same Button so drag-reorder, hit
                                 testing and cell sizing are identical. -->
                            <Panel HorizontalAlignment="Center" ClipToBounds="False">
                                <Panel IsVisible="{Binding IsNotSeparator}" ClipToBounds="False">
                                    <Image Source="{Binding Icon}"
                                           Width="{Binding IconSize}"
                                           Height="{Binding IconSize}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality">
                                        <Image.RenderTransform>
                                            <TranslateTransform Y="{Binding BounceOffset}"/>
                                        </Image.RenderTransform>
                                    </Image>
                                    <Ellipse Width="4" Height="4"
                                             Fill="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,0,-7"
                                             IsVisible="{Binding IsRunning}" />
                                </Panel>
                                <!-- Divider: sized across the dock's minor axis
                                     by the VM, so it follows icon size and
                                     flips with a vertical dock. -->
                                <Border IsVisible="{Binding IsSeparator}"
                                        Width="{Binding SeparatorWidth}"
                                        Height="{Binding SeparatorHeight}"
                                        Background="White"
                                        Opacity="0.35"
                                        CornerRadius="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Drop indicator: a thin bar at the target gap while an icon is
                 being dragged. Positioned via Margin from code-behind; its
                 orientation follows the dock (vertical bar for a horizontal
                 dock, horizontal bar for a vertical one). -->
            <Border x:Name="DropIndicator" IsVisible="False"
                    Background="White" Opacity="0.85" CornerRadius="1"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Panel>

            <!-- Separator between pinned items and running apps -->
            <Image Source="/Assets/icons/open-softwares-separator-1.png"
                   Width="14" Height="{Binding IconsSize}"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Margin="4,0"
                   IsVisible="{Binding ShowHorizontalSeparator}"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
            <Image Source="/Assets/icons/open-softwares-separator-2.png"
                   Width="{Binding IconsSize}" Height="14"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,4"
                   IsVisible="{Binding ShowVerticalSeparator}"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>

            <!-- Running-but-unpinned apps (taskbar-like) -->
            <ItemsControl ClipToBounds="False" ItemsSource="{Binding RunningApps}"
                          IsVisible="{Binding HasRunningApps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding DockOrientation}" Spacing="{Binding Spacing}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RunningAppViewModel">
                        <Button Background="Transparent"
                                BorderBrush="Transparent"
                                Padding="4"
                                Cursor="Hand"
                                ToolTip.Tip="{Binding Label}"
                                ToolTip.Placement="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).TooltipPlacement}"
                                ToolTip.VerticalOffset="0"
                                ToolTip.HorizontalOffset="0"
                                ToolTip.ShowDelay="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).PreviewDelayMs}"
                                RenderTransformOrigin="50%, 50%"
                                Click="OnRunningAppClicked"
                                PointerEntered="OnRunningAppPointerEntered"
                                PointerExited="OnItemPointerExited"
                                ContextRequested="OnRunningAppContextRequested">

                            <Button.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                                </Transitions>
                            </Button.Transitions>

                            <Button.Styles>
                                <Style Selector="Button">
                                    <Setter Property="RenderTransform" Value="scale(1)" />
                                </Style>
                                <Style Selector="Button:pointerover">
                                    <Setter Property="RenderTransform" Value="scale(1.3)" />
                                </Style>
                                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <!-- Attention bounce translates the icon above the button; don't clip it. -->
                                <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="ClipToBounds" Value="False" />
                                </Style>
                            </Button.Styles>

                            <!-- Item content: icon + running indicator.
                                 The dot must NOT take part in layout: in a
                                 StackPanel it appears only while running, so
                                 the cell grew by dot+spacing and the centered
                                 icon visibly hopped up the moment an app
                                 opened. Here a Panel is sized by the icon
                                 alone and the dot is pulled below it with a
                                 negative bottom margin (-7 cancels its own
                                 4px height, leaving a 3px gap), so toggling
                                 it never moves anything. It draws into the
                                 dock bar's 10px padding — ClipToBounds is
                                 already off all the way up for the bounce. -->
                            <Panel HorizontalAlignment="Center" ClipToBounds="False">
                                <Image Source="{Binding Icon}"
                                       Width="{Binding IconSize}"
                                       Height="{Binding IconSize}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality">
                                    <Image.RenderTransform>
                                        <TranslateTransform Y="{Binding BounceOffset}"/>
                                    </Image.RenderTransform>
                                </Image>
                                <Ellipse Width="4" Height="4"
                                         Fill="White"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,-7"
                                         IsVisible="{Binding IsRunning}" />
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
